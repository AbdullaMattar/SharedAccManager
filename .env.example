# Database — SQLite file path (relative or absolute)
DATABASE_URL=file:./data/app.db

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here

# AES-256-GCM encryption key for stored account passwords
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Optional: seeded admin credentials (defaults shown)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Server port (set by Replit automatically)
PORT=5000
